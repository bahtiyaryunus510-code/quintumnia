# JSON array for the Solana keypair that owns the QMN source token account.
QMN_AUTHORITY_SECRET_KEY=[1,2,3]

# Mainnet or Devnet QMN token account owned by the authority.
QMN_SOURCE_TOKEN_ACCOUNT=

# Keep false until the backend has been tested with the Mainnet mint.
ENABLE_MAINNET_ALLOCATIONS=false
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
