{
  "name": "quintumnia",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "quintumnia.space"
        }
      ],
      "destination": "https://www.quintumnia.space/:path*",
      "permanent": true
    }
  ]
}
